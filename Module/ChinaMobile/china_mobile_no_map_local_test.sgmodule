#!name=中国移动去广告（无本地拦截测试版）
#!desc=仅排查用：禁用 Map Local 静态拦截，保留全部响应脚本、AES 加解密和诊断日志。测试时务必先关闭正式模块。
#!author=ccyykk666 (original), Surge adaptation
#!system=ios
#!date=2026-10-29
#!icon=https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/china-mobile/icon.png
#!arguments=HideTopFamily:false,HideTopAge:false,HideTopPhone:false,HideTopNearby:false,HideTopAI:false,HideTopEnterprise:false,BottomClean:true,MineClean:true,Diagnostic:true
#!arguments-desc=填写 true=开启、false=关闭。HideTopFamily=隐藏爱家；HideTopAge=隐藏网龄；HideTopPhone=隐藏手机；HideTopNearby=隐藏附近厅；HideTopAI=隐藏AI；HideTopEnterprise=隐藏政企（以上默认false）；BottomClean=底栏净化；MineClean=我的页面净化（两者默认true）；Diagnostic=诊断日志（默认true，排查完成后改false）。长按已安装模块可编辑参数。

# 排查版：刻意不启用 Map Local，以排查本地模拟响应是否影响 App。
# 其他 AES / 过滤逻辑与正式诊断版完全一致。

[Script]
# 所有动态响应由一个脚本处理；Surge 对每个响应最多运行一个 http-response 脚本。
中国移动页面广告净化 = type=http-response,pattern=^https:\/\/(?:client\.app\.coc\.10086\.cn\/biz-orange\/(?:DN\/(?:homePage\/getTopAreaList|multipleInterfaces\/aggregationData|searchWord\/getSearchWordInfo|init\/getNavigation|bottomNavigationService\/getNavigationInfo|myPageNew\/getMyPageNew)|DA\/baseServiceFunction\/getAdverList)|h\.app\.coc\.10086\.cn\/biz-orange\/DH\/(?:message_query\/message\/query\/list|myCardVoucher\/getBannerList)|app\.10086\.cn\/biz-orange\/DA\/commonBoard\/getCommonBoard|touch\.10086\.cn\/i\/v1\/(?:cust\/(?:aiMainQry|iopBatchQry)\/[^?]+|pay\/popWindowQry\/[^?]+)|ad\.mcloud\.139\.com\/advertapi\/adv-filter\/adv-filter\/AdInfoFilter\/getAdInfos)(?:\?.*)?$,script-path=https://raw.githubusercontent.com/Ailurus503/Surge/main/Module/ChinaMobile/china_mobile_surge.js?v=20261029diag1,script-update-interval=300,requires-body=true,max-size=2097152,timeout=15,engine=webview,debug=true,argument=HideTopFamily={{{HideTopFamily}}}&HideTopAge={{{HideTopAge}}}&HideTopPhone={{{HideTopPhone}}}&HideTopNearby={{{HideTopNearby}}}&HideTopAI={{{HideTopAI}}}&HideTopEnterprise={{{HideTopEnterprise}}}&BottomClean={{{BottomClean}}}&MineClean={{{MineClean}}}&Diagnostic={{{Diagnostic}}}

[MITM]
hostname = %APPEND% client.app.coc.10086.cn, h.app.coc.10086.cn, app.10086.cn, touch.10086.cn, ad.mcloud.139.com